{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/vesplus",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/vesplus/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/vesplus/(.*)",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/beatrix",
      "destination": "/beatrix/",
      "permanent": false
    },
    {
      "source": "/rawdon",
      "destination": "/rawdon/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/beatrix/",
      "destination": "/beatrix-demo/index.html"
    },
    {
      "source": "/beatrix/(.*)",
      "destination": "/beatrix-demo/$1"
    },
    {
      "source": "/rawdon/",
      "destination": "/site/index.html"
    },
    {
      "source": "/rawdon/(.*)",
      "destination": "/site/$1"
    },
    {
      "source": "/",
      "destination": "/vesplus-demo/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/vesplus-demo/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|mp4|webm|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
